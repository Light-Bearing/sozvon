{
  "name": "sozvon",
  "version": "0.28.0",
  "description": "Видео и голос напрямую между устройствами. Без серверной части, без аккаунтов, без оплаты.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "vitest run",
    "dev": "vite --host",
    "build": "vite build",
    "build:single": "vite build --config vite.config.single.js",
    "check:call": "node tools/call-check.mjs",
    "check:mesh": "node tools/mesh-check.mjs",
    "check:hand": "node tools/manual-check.mjs",
    "check:cross": "node tools/cross-check.mjs",
    "check:screen": "node tools/screen-check.mjs",
    "check:reload": "node tools/reload-check.mjs",
    "check:outage": "node tools/outage-check.mjs",
    "check:lobby": "node tools/lobby-check.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "private": "true",
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1",
    "@trystero-p2p/core": "0.25.4",
    "@trystero-p2p/mqtt": "0.25.4",
    "@trystero-p2p/nostr": "0.25.4"
  },
  "devDependencies": {
    "jsdom": "30.0.1",
    "vite": "8.3.0",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.0"
  }
